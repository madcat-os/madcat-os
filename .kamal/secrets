# Resolved at deploy time from nani (config.saiden.dev); no values live here.
# `nani --plain get` prints the raw value. Do NOT pipe through `tr -d '\r\n'`:
# Kamal's dotenv parser leaves the backslashes alone and tr then strips the
# letters r and n from the secret.
#
# Shared with the Rust madcat-mcp deploy (`nani ls madcat-mcp prod`). No database
# DSN: every user's database URL comes from madcat-web's token introspection.

KAMAL_REGISTRY_PASSWORD=$(nani --plain get tokens prod gitea-token-madcat)

MADCAT_OAUTH_INTROSPECT_SECRET=$(nani --plain get madcat-mcp prod oauth-introspect-secret | tr -d '[:space:]')
MADCAT_EMBED_API_KEY=$(nani --plain get madcat-mcp prod embed-api-key)
